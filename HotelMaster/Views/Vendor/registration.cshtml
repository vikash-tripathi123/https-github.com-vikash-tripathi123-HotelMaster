<script>
    document.querySelectorAll(".card-header").forEach(header => {
    header.addEventListener("click", () => {

      const card = header.parentElement;

      document.querySelectorAll(".card").forEach(c => {
          if (c !== card) c.classList.remove("active");
      });

      card.classList.toggle("active");
    });
    });
</script>
<script>
    const tabButtons = document.querySelectorAll('.tab-btn');
    const hotelTab = document.getElementById('hotelTab');
    const roomTab = document.getElementById('roomTab');

    tabButtons.forEach(btn => {
      btn.addEventListener('click', () => {

        // button active
        tabButtons.forEach(b => b.classList.remove('active'));
        btn.classList.add('active');

        // hide both
        hotelTab.classList.remove('active');
        roomTab.classList.remove('active');

        // show selected
        if (btn.dataset.tab === 'hotel') {
          hotelTab.classList.add('active');
        } else {
          roomTab.classList.add('active');
        }

      });
    });
</script>

