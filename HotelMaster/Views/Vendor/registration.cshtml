                                 <option value="1">Reception</option>
                              </select>
                              <span asp-validation-for="vendorContactRequest[i].Department" class="text-danger"></span>
                           </div>
                           <div class="form-group">
                              <label asp-for="vendorContactRequest[i].Designation"></label>
                              <select asp-for="vendorContactRequest[i].Designation">
                                 <option value="">Select Designation</option>
                                 <option value="1">Hotel Manager</option>
                              </select>
                              <span asp-validation-for="vendorContactRequest[i].Designation" class="text-danger"></span>
                           </div>
                         @*   @if (i != 0)
                           {
                           <button type="button" class="removeRow">Remove</button>
                           } *@
                        </div>
                        }

                              
                     </div>
                  </form>

