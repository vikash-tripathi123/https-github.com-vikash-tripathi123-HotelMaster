@using HotelMaster.Models.ResponseModels.MasterModels @{
    
    ViewData["Title"] ="Vendor List"; 
    
    ViewBag.PageTitle = "Vendor Management"; 
    
    ViewBag.PageDescription= "Manage vendors and services."; 
    
    Layout ="~/Views/Shared/Layouts/_MainLayout.cshtml";

    string[] Payment =
{
        "Advance",
        "BTC"
        
    };
}

<style>
    .scroll-filter {
        max-height: 160px;
        overflow-y: auto;
        overflow-x: hidden;
    }

      /* Fix the select width */
     .scroll-filter select {
            width: 100%;
            box-sizing: border-box;
        }
</style>

<div class="wrapper">
    <!-- MAIN -->
    <div class="layout">
        <!-- SIDEBAR -->
        @Html.AntiForgeryToken()
        <div class="sidebar">
            <b>Filters</b>

            <!-- Service Category -->
            @await Component.InvokeAsync("ServiceMaster")

            <!-- Property Type -->
            @* @await Component.InvokeAsync("Property") *@
           <div class="filter-group">
            <small class="filter-title">Payment</small>
                <div class="filter-content">

                    @foreach (var item in Payment)
                    {
                        <label class="custom-checkbox">

                            <input type="checkbox"
                                   name="payment"
                                   value="@item" />

                            <span class="checkmark"></span>

                            @item

                        </label>
                    }

                </div>
</div>

            <!-- STATE -->
            @await Component.InvokeAsync("Dropdown")

            <!-- City-->
            <div class="scroll-filter">
                <select class="form-control" id="citySelect">
                    <option value="" selected>-- Select City --</option>
                </select>
            </div>

            <!-- CLEAR -->
            <button class="clear-btn filterClearCta" id="clearFilter">Clear All Filters</button>
        </div>

        <!-- TABLE -->

        <div class="vendorTable">
            <div class="vendor-header-section">
                <div class="stats-grid-row">
                    <div class="stat-card-item border-l-blue">
                        <div class="stat-content-wrapper">
                            <span class="stat-label-text">HOTEL VENDORS</span>
                            <span class="stat-main-number">482</span>
                        </div>
                        <div class="stat-icon-circle bg-soft-blue">
                            <img src="~/img/kpi-1.svg" />
                        </div>
                    </div>

                    <div class="stat-card-item border-l-green">
                        <div class="stat-content-wrapper">
                            <span class="stat-label-text">TRANSPORT VENDORS</span>
                            <span class="stat-main-number">315</span>
                        </div>
                        <div class="stat-icon-circle bg-soft-green">
                            <img src="~/img/kpi-2.svg" />
                        </div>
                    </div>

                    <div class="stat-card-item border-l-orange">
                        <div class="stat-content-wrapper">
                            <span class="stat-label-text">SIGHTSEEING/GUIDES</span>
                            <span class="stat-main-number">126</span>
                        </div>
                        <div class="stat-icon-circle bg-soft-orange">
                            <img src="~/img/kpi-3.svg" />
                        </div>
                    </div>
                </div>

                <div class="search-actions-row">
                    <div class="search-bar-container">
                        <span class="vendorSearch">
                            <img src="~/img/vendor-search.svg" onclick="removeGlobalSearch()"/>
                        </span>
                        <input type="text"
                               class="header-search-input" id="globalSearch"
                               placeholder="Search by Name, Ticket No, Date etc....."  />
                    </div>

                    <div class="right-controls-group">
                        <span class="sort-by-text">Sort by:</span>
                        <div class="select-wrapper">
                            <select class="header-sort-dropdown">
                                <option>All</option>
                            </select>
                        </div>
                        <a >
                            <button class="addvendor" onclick="AddVendorPage()">Add Vendor</button>
                        </a>
                    </div>
                </div>
            </div>
            <div class="vendorTableInner">
                <table class="table-custom">
                    <thead>
                        <tr>
                            <th>Vendor Name</th>
                            <th>Service Type</th>
                            <th>LOCATION</th>
                            <th>Contact Info</th>
                            <th>
                                Payment <br />
                                Type
                            </th>

                            <th>Status</th>
                            <th>ACTION</th>
                        </tr>
                    </thead>

                    <tbody id="data"></tbody>
                </table>

                <div class="table-footer">
                    <!-- Left -->
                    <div class="pagination-info">
                        <!-- ✅ This will be filled dynamically -->
                    </div>

                    <!-- Right -->
                    <div class="pagination-controls">
                        <!-- Rows per page -->
                        <div class="rows-per-page">
                            <label>Rows per page:</label>
                            <div class="dropdown-trigger-box">
                                <select class="dropdown-trigger-box__native">
                                    <option value="10">10</option>
                                    <option value="20">20</option>
                                    <option value="50">50</option>
                                </select>
                                <div class="dropdown-trigger-box__chevron"></div>
                            </div>
                        </div>

                        <!-- ✅ Pagination buttons (EMPTY — JS will fill) -->
                        <div class="inventory-pagination__list"></div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<script src="~/js/modules/vendor/vendor.js"></script>
