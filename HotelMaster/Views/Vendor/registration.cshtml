                   <form method="post" id="vendorContactForm">
                            @Html.AntiForgeryToken()
                     <div id="contactContainer">
                        @for (int i = 0; i < Model.vendorContactRequest.Count; i++)
                        {
                        <div class="contact-row form-grid restaurantsGrid">
                                        <input asp-for="vendorContactRequest[i].VendorContactId" type="hidden" />
