    <script>
        const buttons = document.querySelectorAll('.view-btn');
        const tabs = document.querySelectorAll('.manageTabs');

        buttons.forEach(btn => {
            btn.addEventListener('click', function () {

                // remove active from all buttons
                buttons.forEach(b => b.classList.remove('active'));
                this.classList.add('active');

                // hide all tabs
                tabs.forEach(tab => tab.classList.remove('active-tab'));

                // show selected tab
                const target = this.getAttribute('data-tab');
                document.getElementById(target).classList.add('active-tab');
            });
        });
    </script>

    <script>
        const mainTabs = document.querySelectorAll('.rate-tab');
        const mainContents = document.querySelectorAll('.mainTabContent');

        mainTabs.forEach(tab => {
            tab.addEventListener('click', function () {

                // remove active from tabs
                mainTabs.forEach(t => t.classList.remove('active'));
                this.classList.add('active');

                // hide all contents
                mainContents.forEach(c => c.classList.remove('active-main-tab'));

                // show selected
                const target = this.getAttribute('data-tab');
                document.getElementById(target).classList.add('active-main-tab');
            });
        });
    </script>


