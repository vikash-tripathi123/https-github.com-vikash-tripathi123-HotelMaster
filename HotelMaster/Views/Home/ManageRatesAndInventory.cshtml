<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Hotel Listing</title>
    <link href="https://fonts.googleapis.com/css2?family=Roboto+Condensed:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <link href="/css/site.css" rel="stylesheet" />
 
</head>
<body>
    <!-- HEADER -->
    <div class="container-fluid p-0">
        <img src="/img/header-add.jpg" class="img-fluid" />
    </div>
    <div class="wrapper">
        <div class="container">
            <!-- HEADER -->
            <div class="header">
                <div>
                    <div class="breadcrumb">
                        <span class="headerHome"><img src="/img/home.svg"> </span>
                        
                        <span class="headerChevron"><img src="/img/chevron-right.svg">  </span>
                        <span class="headerEditAdd">
                            @* <img src="/img/edit_add.svg"> *@
                            Manage Rates
                        </span>
                    </div>
                    <h1>Manage Rates And Inventory</h1>
                    <p>Hotel Green Valley, Karol Bagh, New Delhi</p>
                </div>
                <div class="save-time">  <span class="headerTime"><img src="/img/time.svg"></span> Last saved 2 minutes ago</div>
            </div>
            <!-- PROGRESS -->

        </div>
    </div>
    <div class="manageRatesContaier">
        <div class="wrapper">
            <div class="container">


                <!-- Tabs -->
                <div class="rate-tabs">
                    <div class="rate-tab active" data-tab="ratesTab">
                        <span><img src="~/img/rates.svg" /></span> Rates
                    </div>
                    <div class="rate-tab" data-tab="inventoryTab">
                        <span><img src="~/img/Inventory.svg" /></span> Inventory
                    </div>
                </div>
                <!-- RATES TAB CONTENT -->
                <div id="ratesTab" class="mainTabContent active-main-tab">
                <!-- View Switch -->
                <div class="view-switch">
                    <button class="view-btn active" data-tab="weekTab">Week View</button>
                    <button class="view-btn" data-tab="monthTab">Month View</button>
                    <button class="view-btn" data-tab="reportTab">Report View</button>
                </div>
                <!--first tab-->
                <div class="manageTabs active-tab" id="weekTab">
                <!-- Action Bar -->
                <div class="action-bar">
                    
                    <button class="add-rate-btn">+ ADD RATES</button>
                    <div class="actionBarRight">
                    <button class="nav-btn"><span><img src="~/img/left-icon.svg" /></span></button>
                    <button class="nav-btn"><span><img src="~/img/calender.svg" /></span></button>
                    <button class="nav-btn"><span><img src="~/img/right-icon.svg" /></span></button>
                </div>
                </div>

                <!-- Expand -->
                    <div class="expand-link"><span>+</span> Expand All Rooms And Meal Plans</div>

                <!-- Table -->
                <div class="rate-table">

                    <!-- Header -->
                    <div class="rate-header">

                        <div class="header-left"><span><img src="~/img/rooms.svg"/></span>Rooms &amp; Rates</div>

                        <!-- Days -->
                        <div class="header-day">
                            <div class="season-label">WINTER SEASON</div>
                            <div class="day-box active">
                                <div class="day-name">SUN</div>
                                <div class="day-number">21</div>
                                <div class="day-date">DEC 2025</div>
                            </div>
                        </div>

                        <div class="header-day">
                            <div class="season-label">WINTER SEASON</div>
                            <div class="day-box">
                                <div class="day-name">MON</div>
                                <div class="day-number">22</div>
                                <div class="day-date">DEC 2025</div>
                            </div>
                        </div>

                        <div class="header-day">
                            <div class="season-label">WINTER SEASON</div>
                            <div class="day-box">
                                <div class="day-name">TUE</div>
                                <div class="day-number">23</div>
                                <div class="day-date">DEC 2025</div>
                            </div>
                        </div>

                        <div class="header-day">
                            <div class="season-label">WINTER SEASON</div>
                            <div class="day-box">
                                <div class="day-name">WED</div>
                                <div class="day-number">24</div>
                                <div class="day-date">DEC 2025</div>
                            </div>
                        </div>

                        <div class="header-day">
                            <div class="season-label">CHRISTMAS</div>
                            <div class="day-box">
                                <div class="day-name">THU</div>
                                <div class="day-number">25</div>
                                <div class="day-date">DEC 2025</div>
                            </div>
                        </div>

                        <div class="header-day">
                            <div class="season-label">WINTER SEASON</div>
                            <div class="day-box">
                                <div class="day-name">FRI</div>
                                <div class="day-number">26</div>
                                <div class="day-date">DEC 2025</div>
                            </div>
                        </div>

                        <div class="header-day">
                            <div class="season-label">WINTER SEASON</div>
                            <div class="day-box">
                                <div class="day-name">SAT</div>
                                <div class="day-number">27</div>
                                <div class="day-date">DEC 2025</div>
                            </div>
                        </div>

                    </div>

                    <!-- Rows -->
                    <div class="rate-row">
                        <div class="room-name">
                            <div class="room-toggle">+</div>
                            Royal Suit Room
                        </div>
                        <div class="row-right">
                            <div class="arrow-btn"><img src="~/img/table-arrow.svg"/></div>
                        </div>
                    </div>

                    <div class="rate-row">
                        <div class="room-name">
                            <div class="room-toggle">+</div>
                            Deluxe Room
                        </div>
                        <div class="row-right">
                            <div class="arrow-btn"><img src="~/img/table-arrow.svg" /></div>
                        </div>
                    </div>

                    <div class="rate-row">
                        <div class="room-name">
                            <div class="room-toggle">+</div>
                            Executive Room
                        </div>
                        <div class="row-right">
                            <div class="arrow-btn"><img src="~/img/table-arrow.svg" /></div>
                        </div>
                    </div>

                </div>
                </div>
                <!--second tab-->
                <div class="manageTabs" id="monthTab">

                    <div class="filter-bar">
                        <div class="filter-shell-wrap">
                            <div class="filterShellTrigger">
                                <div>
                                    <label>Room Type</label>
                                </div>
                                <div class="dropdown-trigger-box">

                                    <select class="dropdown-trigger-box__native">
                                        <option>Royal Suit Room</option>
                                        <option>Royal Suit Room</option>

                                    </select>
                                    <div class="dropdown-trigger-box__chevron"></div>
                                </div>
                            </div>





                            <div class="filterShellTrigger">
                                <div>
                                    <label>Price Type</label>
                                </div>
                                <div class="dropdown-trigger-box">

                                    <select class="dropdown-trigger-box__native">
                                        <option>Double</option>
                                        <option>Double</option>

                                    </select>
                                    <div class="dropdown-trigger-box__chevron"></div>
                                </div>
                            </div><div class="filterShellTrigger">
                                <div>
                                    <label>Meal Plan</label>
                                </div>
