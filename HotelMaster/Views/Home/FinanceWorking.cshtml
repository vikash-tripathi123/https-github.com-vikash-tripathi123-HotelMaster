<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Finance Working - Vendor Details</title>

    <!-- Lucide Icons -->


    <style>
        /* CSS Reset */
        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
        }

        body {
            font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
            background-color: #f3f4f6;
            color: #334155;
        }

        /* HEADER CLASSES */
        .fw-header-container {
            width: 100%;
            padding: 0;
        }

        h1.h4.mb-1.vendorfinance {
            color: #5a5a5a;
            border-bottom: 1px solid;
            margin-bottom: 15px !important;
        }

        .fw-header-img {
            width: 100%;
            height: auto;
            display: block;
        }

        /* MAIN CONTAINER CLASS */
        .fw-main-wrapper {
            max-width: 1115px;
            margin: 20px auto 25px auto;
            padding: 10px;
            background-color: #ffffff;
            /* border: 1px dashed #38bdf8; */
            border-radius: 4px;
            display: flex;
            flex-direction: column;
            gap: 10px;
        }

        tbody tr:nth-child(odd) {
            background: none;
        }
        /* TITLE / SUBTITLE CLASSES */
        .fw-title-block {
            display: flex;
            flex-direction: column;
        }

        .fw-title-text {
            font-size: 22px;
            font-weight: 700;
            color: #5a5a5a;
            margin-bottom: 0;
        }

        .fw-subtitle-text {
            display: flex;
            align-items: center;
            gap: 8px;
            font-size: 12px;
            color: #64748B;
            margin-top: 4px;
        }

            .fw-subtitle-text svg {
                width: 16px;
                height: 16px;
            }

        /* CARD COMPONENTS */
        .fw-card {
            border: 1px solid #e2e8f0;
            border-radius: 6px;
            overflow: hidden;
            background-color: #ffffff;
        }

        .fw-card-header {
            background-color: #e0f2fe;
            padding: 10px 16px;
            font-weight: 700;
            font-size: 14px;
            color: #5A5A5A;
            border-bottom: 1px solid #F1F5F9;
        }

        .fw-card-body {
            padding: 20px;
        }

        /* BUSINESS INFORMATION GRID CLASSES */
        .fw-info-grid-4 {
            display: grid;
            grid-template-columns: repeat(4, 1fr);
            gap: 16px;
            text-align: center;
            margin-bottom: 15px;
        }

        .fw-info-grid-3 {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 16px;
            text-align: center;
            max-width: 650px;
        }

        .fw-info-item-label {
            font-size: 12px;
            color: #7386A1;
            font-weight: 500;
            margin-bottom: 0;
            line-height: normal;
        }

        .fw-info-item-value {
            font-size: 13px;
            font-weight: 700;
            color: #5A5A5A;
        }

        /* CONTACT DIRECTORY TABLE CLASSES */
        .fw-table-container {
            width: 100%;
            overflow-x: auto;
        }

        .fw-contact-table {
            width: 100%;
            border-collapse: collapse;
            font-size: 12px;
            text-align: center;
        }

        .fw-table-head-cell {
            font-size: 11px;
            text-transform: uppercase;
            letter-spacing: 0.05em;
            color: #64748B;
            font-weight: 600;
            padding: 12px 16px;
            border-bottom: 1px solid #e2e8f0;
        }

        .fw-table-body-cell {
            padding: 14px 16px;
            border-bottom: 1px solid #F1F5F9;
            font-weight: 600;
            color: #64748B;
        }

        .fw-table-body-cell-bold {
            padding: 14px 16px;
            border-bottom: 1px solid #f1f5f9;
            font-weight: 600;
            color: #0F172A;
        }

        /* FINANCIAL & COMPLIANCE BOX CLASSES */
        .fw-box-grid-3 {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 16px;
        }

        .fw-finance-box {
            border: 1px solid #000000;
            border-radius: 12px;
            padding: 16px;
            background-color: #E0F2FE;
            display: flex;
            flex-direction: column;
            justify-content: space-between;
        }

        .fw-finance-box-title {
            font-weight: 700;
            font-size: 14px;
            color: #5A5A5A;
            margin-bottom: 12px;
        }

        .fw-finance-row {
            display: flex;
            justify-content: space-between;
            font-size: 12px;
            margin-bottom: 4px;
        }

        .fw-finance-label {
            color: #7386A1;
            font-weight: 500;
        }

        .fw-finance-value {
            font-weight: 700;
            color: #5A5A5A;
        }

        /* COMPLIANCE DOCUMENTS GRID CLASSES */
        .fw-docs-grid {
            display: grid;
            grid-template-columns: repeat(5, 1fr);
            gap: 12px;
        }

        .fw-doc-item {
            border: 1px solid #E2E8F0;
            border-radius: 8px;
            padding: 12px;
            background-color: #F8FAFC4D;
            display: flex;
            flex-direction: column;
            justify-content: space-between;
            min-height: 60px;
        }

        .fw-doc-header {
            display: flex;
            align-items: center;
            gap: 6px;
            overflow: hidden;
        }

            .fw-doc-header svg {
                width: 16px;
                height: 16px;
                flex-shrink: 0;
            }

        .fw-doc-title {
            font-size: 12px;
            font-weight: 700;
            color: #0F172A;
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
        }

        .fw-doc-footer {
            display: flex;
            align-items: center;
            justify-content: space-between;
            font-size: 11px;
            color: #94a3b8;
            margin-top: 8px;
        }

        .fw-doc-action-group {
            display: flex;
            align-items: center;
            gap: 8px;
        }

        img.fw-header-img-icon {
            width: 100%;
            max-width: 18px;
            max-height: 18px;
        }
        .fw-doc-btn {
            background: none;
            border: none;
            cursor: pointer;
            color: #94a3b8;
            padding: 0;
            display: flex;
            align-items: center;
        }

            .fw-doc-btn:hover {
                color: #475569;
            }

            .fw-doc-btn svg {
                width: 14px;
                height: 14px;
            }

        .fw-doc-placeholder {
            border: 1px solid #f1f5f9;
            background-color: #fafafa;
        }

    </style>
</head>
