                                    <select class="dropdown-trigger-box__native">
                                        <option>Meal Plan</option>
                                        <option>Meal Plan</option>

                                    </select>
                                    <div class="dropdown-trigger-box__chevron"></div>
                                </div>
                            </div>
                            <div class="filterShellTrigger">
                                <div>
                                    <label>MONTH &amp; YEAR</label>
                                </div>
                                <div class="ratesFilterItem">


                                    <div class="ratesMonthBox">
                                        <button class="ratesNavBtn">‹</button>
                                        <span>December 2025</span>
                                        <button class="ratesNavBtn">›</button>
                                    </div>
                                </div>
                            </div><div class="filterShellTrigger">
                                <div>
                                    <label></label>
                                </div>
                                <div class="ratesFilterItem">


                                    <button class="ratesResetBtn">Reset Filters</button>
                                </div>
                            </div>
                        </div>


